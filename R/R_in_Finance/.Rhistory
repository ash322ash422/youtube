# Load packages
library(tidyverse)    # ggplot2, dplyr, tidyr, readr, etc.
library(skimr)        # rich summary statistics
library(ggcorrplot)   # correlation heatmaps
library(scales)       # axis formatting (commas, percent)
library(knitr)        # nice tables
library(RColorBrewer) # colour palettes
# A clean ggplot theme for all plots
theme_set(theme_minimal(base_size = 13))
# ── IMPORTANT ──────────────────────────────────────────────────────────────
# Place bank.csv in your working directory, then run:
#   setwd("path/to/your/folder")   # or use Session > Set Working Directory
# ───────────────────────────────────────────────────────────────────────────
bank <- read_delim("data_bank.csv", delim = ";", show_col_types = FALSE)
# Peek at the first few rows
head(bank, 8)
# How big is the dataset?
cat("Rows   :", nrow(bank), "\n")
cat("Columns:", ncol(bank), "\n")
# glimpse() gives a compact overview of every column
glimpse(bank)
# Convert character columns to factors (R's category type)
# Factors are essential for modelling and ordered plots
categorical_vars <- c("job", "marital", "education", "default",
"housing", "loan", "contact", "month",
"poutcome", "y")
bank <- bank %>%
mutate(across(all_of(categorical_vars), as.factor))
# Verify
glimpse(bank)
summary(bank)
skim(bank)
# Frequency table
bank %>%
count(y) %>%
mutate(pct = n / sum(n))
bank %>%
count(y) %>%
mutate(pct = n / sum(n),
label = paste0(round(pct * 100, 1), "%")) %>%
ggplot(aes(x = y, y = n, fill = y)) +
geom_col(width = 0.5, show.legend = FALSE) +
geom_text(aes(label = label), vjust = -0.4, size = 5, fontface = "bold") +
scale_fill_manual(values = c("no" = "#e07070", "yes" = "#4caf7d")) +
scale_y_continuous(labels = comma) +
labs(
title    = "Term Deposit Subscription Rate",
subtitle = "Target variable distribution — class imbalance is evident",
x        = "Subscribed?",
y        = "Number of Clients"
)
ggplot(bank, aes(x = age)) +
geom_histogram(binwidth = 5, fill = "#4a90d9", colour = "white") +
geom_vline(xintercept = median(bank$age), linetype = "dashed",
colour = "firebrick", linewidth = 0.9) +
annotate("text", x = median(bank$age) + 2, y = Inf,
label = paste("Median =", median(bank$age)),
vjust = 1.5, hjust = 0, colour = "firebrick", size = 4.5) +
labs(title = "Distribution of Client Age",
x = "Age", y = "Count")
# Balance has extreme outliers — log scale helps visualise
bank %>%
filter(balance > 0) %>%          # log is undefined for 0 / negative
ggplot(aes(x = balance)) +
geom_histogram(bins = 60, fill = "#f5a623", colour = "white") +
scale_x_log10(labels = comma) +
labs(title = "Distribution of Account Balance (positive values, log scale)",
x = "Balance (€, log scale)", y = "Count")
# Five-number summary + mean for balance
bank %>%
summarise(
Min    = min(balance),
Q1     = quantile(balance, 0.25),
Median = median(balance),
Mean   = round(mean(balance), 1),
Q3     = quantile(balance, 0.75),
Max    = max(balance),
SD     = round(sd(balance), 1)
) %>%
kable(caption = "Balance (€) Summary Statistics")
ggplot(bank, aes(x = duration)) +
geom_boxplot(fill = "#9b59b6", alpha = 0.7, outlier.colour = "grey50") +
scale_x_continuous(labels = comma) +
labs(title = "Boxplot: Last Call Duration (seconds)",
x = "Duration (s)", y = NULL) +
theme(axis.text.y = element_blank())
bank %>%
count(y) %>%
mutate(pct = n / sum(n),
label = paste0(round(pct * 100, 1), "%")) %>%
ggplot(aes(x = y, y = n, fill = y)) +
geom_col(width = 0.5, show.legend = FALSE) +
geom_text(aes(label = label), vjust = -0.4, size = 5, fontface = "bold") +
scale_fill_manual(values = c("no" = "#e07070", "yes" = "#4caf7d")) +
scale_y_continuous(labels = comma) +
labs(
title    = "Term Deposit Subscription Rate",
subtitle = "Target variable distribution — class imbalance is evident",
x        = "Subscribed?",
y        = "Number of Clients"
)
if (!requireNamespace("gridExtra", quietly = TRUE)) install.packages("gridExtra")
library(gridExtra)
if (!requireNamespace("gridExtra", quietly = TRUE)) install.packages("gridExtra")
library(gridExtra)
bank %>%
group_by(y) %>%
summarise(
n           = n(),
Median_Bal  = median(balance),
Mean_Bal    = round(mean(balance), 0),
SD_Bal      = round(sd(balance), 0)
) %>%
kable(caption = "Balance Statistics by Subscription Outcome")
bank %>%
group_by(education, y) %>%
summarise(n = n(), .groups = "drop") %>%
group_by(education) %>%
mutate(pct = n / sum(n)) %>%
ggplot(aes(x = education, y = pct, fill = y)) +
geom_col(position = "fill") +
scale_y_continuous(labels = percent) +
scale_fill_manual(values = c("no" = "#e07070", "yes" = "#4caf7d")) +
labs(title = "Subscription Rate by Education Level",
x = "Education", y = "Proportion", fill = "Subscribed?") +
theme(axis.text.x = element_text(angle = 15, hjust = 1))
bank %>%
group_by(education, y) %>%
summarise(n = n(), .groups = "drop") %>%
group_by(education) %>%
mutate(pct = n / sum(n)) %>%
ggplot(aes(x = education, y = pct, fill = y)) +
geom_col(position = "fill") +
scale_y_continuous(labels = percent) +
scale_fill_manual(values = c("no" = "#e07070", "yes" = "#4caf7d")) +
labs(title = "Subscription Rate by Education Level",
x = "Education", y = "Proportion", fill = "Subscribed?") +
theme(axis.text.x = element_text(angle = 15, hjust = 1))
month_order <- c("jan","feb","mar","apr","may","jun",
"jul","aug","sep","oct","nov","dec")
bank %>%
mutate(month = factor(month, levels = month_order)) %>%
group_by(month) %>%
summarise(
contacts = n(),
sub_rate = mean(y == "yes")
) %>%
ggplot(aes(x = month)) +
geom_col(aes(y = contacts / max(contacts)),
fill = "#aed6f1", alpha = 0.7) +
geom_line(aes(y = sub_rate, group = 1),
colour = "#1a5276", linewidth = 1.2) +
geom_point(aes(y = sub_rate), colour = "#1a5276", size = 3) +
scale_y_continuous(
name     = "Subscription Rate",
labels   = percent,
sec.axis = sec_axis(~ . * max(bank %>% count(month) %>% pull(n)),
name = "Number of Contacts")
) +
labs(title   = "Monthly Contact Volume vs. Subscription Rate",
subtitle = "Bars = contact volume (scaled) | Line = subscription rate",
x = "Month")
month_order <- c("jan","feb","mar","apr","may","jun",
"jul","aug","sep","oct","nov","dec")
bank %>%
mutate(month = factor(month, levels = month_order)) %>%
group_by(month) %>%
summarise(
contacts = n(),
sub_rate = mean(y == "yes")
) %>%
ggplot(aes(x = month)) +
geom_col(aes(y = contacts / max(contacts)),
fill = "#aed6f1", alpha = 0.7) +
geom_line(aes(y = sub_rate, group = 1),
colour = "#1a5276", linewidth = 1.2) +
geom_point(aes(y = sub_rate), colour = "#1a5276", size = 3) +
scale_y_continuous(
name     = "Subscription Rate",
labels   = percent,
sec.axis = sec_axis(~ . * max(bank %>% count(month) %>% pull(n)),
name = "Number of Contacts")
) +
labs(title   = "Monthly Contact Volume vs. Subscription Rate",
subtitle = "Bars = contact volume (scaled) | Line = subscription rate",
x = "Month")
# ── filter()  : keep rows matching a condition ────────────────────────────
bank %>% filter(age > 50, balance > 1000) %>% nrow()
# ── select()  : choose columns ───────────────────────────────────────────
bank %>% select(age, job, balance, y) %>% head(3)
# ── mutate()  : create / modify columns ──────────────────────────────────
bank %>% mutate(balance_k = balance / 1000) %>% select(balance, balance_k) %>% head(3)
# ── group_by() + summarise() : aggregate ─────────────────────────────────
bank %>%
group_by(job) %>%
summarise(avg_balance = mean(balance), n = n()) %>%
arrange(desc(avg_balance)) %>%
head(5)
# ── arrange()  : sort rows ────────────────────────────────────────────────
bank %>% arrange(desc(balance)) %>% select(age, job, balance) %>% head(5)
