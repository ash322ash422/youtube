type = "l",
main = "DAX Index",
xlab = "Day",
ylab = "Index Level"
)
plot(
stocks$DAX,
type = "l",
col = "blue",
ylim = range(stocks$DAX, stocks$FTSE),
main = "DAX vs FTSE",
xlab = "Day",
ylab = "Index Level"
)
lines(stocks$FTSE, col = "red")
legend(
"topleft",
legend = c("DAX", "FTSE"),
col = c("blue", "red"),
lty = 1
)
cor(stocks)
plot(
stocks$DAX,
stocks$CAC,
main = "DAX vs CAC",
xlab = "DAX",
ylab = "CAC"
)
# Equal-weighted portfolio
stocks$Portfolio <- rowMeans(stocks)
head(stocks)
plot(
stocks$Portfolio,
type = "l",
main = "Equal Weighted Portfolio",
xlab = "Day",
ylab = "Portfolio Value"
)
which.max(stocks$DAX)
which.min(stocks$DAX)
max(stocks$DAX)
min(stocks$DAX)
dax_changes <- diff(stocks$DAX)
head(dax_changes)
mean(dax_changes)
sd(dax_changes)
dax_returns <- diff(stocks$DAX) / head(stocks$DAX, -1)
head(dax_returns)
mean(dax_returns)
sd(dax_returns)
hist(
dax_returns,
main = "Histogram of DAX Returns",
xlab = "Daily Return"
)
sum(dax_returns > 0)
sum(dax_returns < 0)
write.csv(stocks, "eu_stocks.csv", row.names = FALSE)
