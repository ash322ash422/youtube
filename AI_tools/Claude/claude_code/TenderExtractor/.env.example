# Copy this file to .env and fill in real values.
# The app runs with local fallbacks for anything left blank,
# EXCEPT Azure OpenAI, which is required for field extraction.

ENV=poc

# --- Pipeline behaviour ---
USE_LOCAL_PDF_FILE=true     # read PDFs from data_uploads/ instead of Blob Storage
USE_CACHE=true              # skip OCR/LLM calls if cached output already exists
PAGES_PER_CHUNK=2
NOTIFY_ON_COMPLETE=false    # set true + fill in NOTIFY_RECIPIENT to email on success
NOTIFY_RECIPIENT=

# --- API (app/api/main.py) ---
# Origins allowed to call the API cross-origin, e.g. a React dev server
# or Streamlit app running on a different port. Comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501

# --- API auth (single user login - POST /login) ---
AUTH_USERNAME=admin
AUTH_PASSWORD=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# If left blank, a random key is generated at process startup instead -
# fine for local dev, but every login token breaks on the next restart.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Frontend (frontend/streamlit_app.py) ---
# Where the Streamlit app should find the API above.
TENDEREXTRACTOR_API_URL=http://127.0.0.1:8000

# --- Azure Blob Storage (optional - falls back to local disk) ---
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_UPLOADS=automation-container
AZURE_STORAGE_CONTAINER_OUTPUT=automation-file-processed
URL_EXPIRY_HOURS=24

# --- Azure AI Document Intelligence (required for OCR) ---
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_KEY=
AZURE_DOCINTEL_MODEL=prebuilt-layout

# --- Azure OpenAI (required for field extraction) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1

# --- Email notifications (optional - pick one provider) ---
AZURE_EMAIL_COMMUNICATIONS_STRING=
AZURE_EMAIL_SENDER=
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
